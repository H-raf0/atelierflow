# Copy to .env on the server and fill in (the .env file is git-ignored).

# Public host name pointing to the server, e.g. atelierflow.duckdns.org
DOMAIN=

# Generate with: openssl rand -base64 32
POSTGRES_PASSWORD=

# JWT signing key, Base64, at least 256 bits. Generate with: openssl rand -base64 48
JWT_SECRET=
